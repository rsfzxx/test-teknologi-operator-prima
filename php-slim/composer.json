{
    "name": "rsfzxx/test-teknologi-operator-prima-php-slim",
    "description": "REST API CRUD Store menggunakan PHP Slim Framework dan MongoDB",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mongodb": "^2.0",
        "mongodb/mongodb": "^2.0",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8080 -t public"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
